<hc:Window x:Class="PostgresBackup.Wpf.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:PostgresBackup.Wpf.Views"
           xmlns:svc="clr-namespace:PostgresBackup.Wpf.Services"
           xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
           mc:Ignorable="d"
           Title="{Binding WindowTitle}"
           Height="680" Width="1000"
           MinHeight="500" MinWidth="750"
           NonClientAreaBackground="{DynamicResource PrimaryBrush}"
           ShowInTaskbar="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側邊欄 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 應用程式標頭 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="🛡️"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="PostgresBackup"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:Loc App_Subtitle}"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部版本資訊 -->
                <TextBlock x:Name="VersionTextBlock"
                           DockPanel.Dock="Bottom"
                           Text="v1.0.0"
                           FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="12,0,12,12"/>

                <!-- 語系切換器 -->
                <ComboBox x:Name="LanguageComboBox"
                          DockPanel.Dock="Bottom"
                          Margin="14,0,14,8"
                          Height="30"
                          ItemsSource="{x:Static svc:LocalizationService.SupportedLanguages}"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 導覽選單 -->
                <StackPanel Margin="12,16,12,0">
                    <RadioButton x:Name="NavSettings"
                                 Content="{l:Loc Nav_Settings}"
                                 IsChecked="True"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Settings"/>
                    <RadioButton x:Name="NavBackup"
                                 Content="{l:Loc Nav_Backup}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Backup"
                                 Margin="0,4,0,0"/>
                    <RadioButton x:Name="NavRestore"
                                 Content="{l:Loc Nav_Restore}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Restore"
                                 Margin="0,4,0,0"/>
                    <RadioButton x:Name="NavHistory"
                                 Content="{l:Loc Nav_History}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="History"
                                 Margin="0,4,0,0"/>
                    <RadioButton x:Name="NavLog"
                                 Content="{l:Loc Nav_Log}"
                                 Style="{StaticResource NavMenuRadioButtonStyle}"
                                 Checked="Nav_Checked" Tag="Log"
                                 Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右側內容區域 -->
        <Border Grid.Column="1" Background="{DynamicResource RegionBrush}">
            <ContentControl x:Name="MainContent">
                <ContentControl.Resources>
                    <views:SettingsView x:Key="SettingsPage" DataContext="{Binding Settings}"/>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</hc:Window>
