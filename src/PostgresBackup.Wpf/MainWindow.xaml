<hc:Window x:Class="PostgresBackup.Wpf.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:views="clr-namespace:PostgresBackup.Wpf.Views"
           xmlns:svc="clr-namespace:PostgresBackup.Wpf.Services"
           xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
           mc:Ignorable="d"
           Title="{Binding WindowTitle}"
           Height="600" Width="960"
           MinHeight="480" MinWidth="720"
           WindowStartupLocation="CenterScreen"
           NonClientAreaBackground="{DynamicResource PrimaryBrush}"
           NonClientAreaForeground="White"
           CloseButtonForeground="White"
           OtherButtonForeground="White"
           Icon="pack://application:,,,/PostgresBackup.Wpf;component/Resources/app.ico"
           ShowInTaskbar="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側邊欄 -->
        <Border Grid.Column="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 應用程式標頭 -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="20,18">
                    <StackPanel>
                        <Image Source="pack://application:,,,/PostgresBackup.Wpf;component/Resources/icon_white.png"
                               Width="36" Height="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PostgresBackup"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:Loc App_Subtitle}"
                                   FontSize="10"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部版本資訊 -->
                <Border DockPanel.Dock="Bottom"
                        Background="#E8F5E9"
                        BorderBrush="#C8E6C9"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <TextBlock Text="{Binding VersionDisplay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DarkPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 語系切換器 -->
                <ComboBox x:Name="LanguageComboBox"
                          DockPanel.Dock="Bottom"
                          Margin="14,0,14,10"
                          Height="30"
                          ItemsSource="{x:Static svc:LocalizationService.SupportedLanguages}"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 導覽選單 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,16,12,0">
                        <RadioButton x:Name="NavSettings"
                                     IsChecked="True"
                                     Style="{StaticResource NavMenuRadioButtonStyle}"
                                     Checked="Nav_Checked" Tag="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconToolsGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Nav_Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBackup"
                                     Style="{StaticResource NavMenuRadioButtonStyle}"
                                     Checked="Nav_Checked" Tag="Backup"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBoxGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Nav_Backup}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRestore"
                                     Style="{StaticResource NavMenuRadioButtonStyle}"
                                     Checked="Nav_Checked" Tag="Restore"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRestoreGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Nav_Restore}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHistory"
                                     Style="{StaticResource NavMenuRadioButtonStyle}"
                                     Checked="Nav_Checked" Tag="History"
                                     Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistoryGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Nav_History}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右側內容區域 -->
        <Border Grid.Column="1" Background="{DynamicResource RegionBrush}">
            <ContentControl x:Name="MainContent">
                <ContentControl.Resources>
                    <views:SettingsView x:Key="SettingsPage" DataContext="{Binding Settings}"/>
                    <views:BackupView x:Key="BackupPage" DataContext="{Binding Backup}"/>
                    <views:RestoreView x:Key="RestorePage" DataContext="{Binding Restore}"/>
                    <views:HistoryView x:Key="HistoryPage" DataContext="{Binding History}"/>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</hc:Window>
