<UserControl x:Class="PostgresBackup.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:PostgresBackup.Wpf.Converters"
             xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ToolStatusToBrushConverter x:Key="ToolStatusToBrushConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="850">

            <!-- 頁面標題 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="4" Height="24" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                <TextBlock Text="{l:Loc Settings_Title}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── 卡片 1: PostgreSQL 客戶端工具 ── -->
            <hc:Card Margin="0,0,0,24" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <!-- 卡片標頭 -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧 " FontSize="14"/>
                            <TextBlock Text="{l:Loc Settings_ClientTools_Title}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,20">
                        <!-- 狀態指示列 -->
                        <Border Background="#0D000000" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 狀態燈號 Badge -->
                                <Border Grid.Column="0"
                                        Background="{Binding ToolStatus, Converter={StaticResource ToolStatusToBrushConverter}}"
                                        CornerRadius="4" Padding="10,4" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToolResult.Status}"
                                               FontWeight="Bold" Foreground="White" FontSize="12"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding SourceDisplay, StringFormat='來源: {0}'}"
                                               FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <!-- 重新偵測按鈕 -->
                                <Button Grid.Column="2"
                                        Content="{l:Loc Settings_Redetect}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding DetectToolsCommand}"
                                        IsEnabled="{Binding IsDetecting, Converter={StaticResource InvertBoolConverter}}"
                                        Padding="14,6"/>
                            </Grid>
                        </Border>

                        <!-- 詳細資訊表格 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc Settings_ToolVersion}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ToolResult.Version, TargetNullValue='(未偵測到)'}"
                                       FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc Settings_PgDumpPath}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ToolResult.PgDumpPath, Mode=OneWay, TargetNullValue='(未偵測到)'}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Loc Settings_PgRestorePath}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ToolResult.PgRestorePath, Mode=OneWay, TargetNullValue='(未偵測到)'}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="psql 路徑"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ToolResult.PsqlPath, Mode=OneWay, TargetNullValue='(未偵測到)'}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Grid>

                        <!-- 自訂路徑指定列 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <hc:TextBox Grid.Column="0"
                                        Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_CustomPath}"
                                        hc:InfoElement.Placeholder="{l:Loc Settings_CustomPath_Placeholder}"/>

                            <Button Grid.Column="2"
                                     Content="{l:Loc Settings_Browse}"
                                     Style="{StaticResource ButtonDefault}"
                                     Command="{Binding BrowseCustomPathCommand}"
                                     VerticalAlignment="Bottom"
                                     Padding="16,0" Height="32"/>
                        </Grid>

                        <!-- 官方安裝指引面板 -->
                        <Border Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,18,0,0"
                                Background="#0A2E7D32"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="ℹ️ " FontSize="14"/>
                                    <TextBlock Text="{l:Loc Settings_Guide_Title}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>

                                <TextBlock Text="{l:Loc Settings_Guide_Intro}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="12" LineHeight="18" Margin="0,0,0,14"/>

                                <!-- winget 快速安裝 -->
                                <Border Background="{DynamicResource RegionBrush}"
                                        CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{l:Loc Settings_Guide_Winget_Title}"
                                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="winget install PostgreSQL.PostgreSQL"
                                                       FontFamily="Consolas, Courier New" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{Binding IsCopied, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=CopiedText, FallbackValue='📋 複製命令'}"
                                                Style="{StaticResource ButtonDefault}"
                                                Command="{Binding CopyWingetCommand}"
                                                VerticalAlignment="Center"
                                                Padding="12,4"/>
                                    </Grid>
                                </Border>

                                <!-- 下載連結按鈕 -->
                                <WrapPanel Margin="0,4,0,10">
                                    <Button Content="🔗 PostgreSQL 官方 Windows 下載"
                                            Style="{StaticResource ButtonDefault}"
                                            Command="{Binding OpenOfficialUrlCommand}"
                                            Margin="0,0,10,6" Padding="14,6"/>

                                    <Button Content="🔗 EnterpriseDB (EDB) 下載專區"
                                            Style="{StaticResource ButtonDefault}"
                                            Command="{Binding OpenEdbUrlCommand}"
                                            Margin="0,0,0,6" Padding="14,6"/>
                                </WrapPanel>

                                <TextBlock Text="{l:Loc Settings_Guide_PostInstallNotice}"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

            <!-- ── 卡片 2: 資料庫連線設定檔管理 ── -->
            <hc:Card Margin="0,0,0,16" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <!-- 卡片標頭 -->
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="14"/>
                            <TextBlock Text="{l:Loc Settings_Connection_Title}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,20">

                        <!-- 設定檔選取與切換工具列 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <hc:ComboBox Grid.Column="0"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile}"
                                         DisplayMemberPath="DisplayName"
                                         hc:InfoElement.Title="{l:Loc Settings_Profile}"
                                         Height="32"/>

                            <Button Grid.Column="2"
                                    Content="{l:Loc Settings_Profile_New}"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding NewProfileCommand}"
                                    Height="32" Padding="12,0"/>

                            <Button Grid.Column="4"
                                    Content="{l:Loc Settings_Profile_Delete}"
                                    Style="{StaticResource ButtonDanger}"
                                    Command="{Binding DeleteProfileCommand}"
                                    IsEnabled="{Binding SelectedProfile, Converter={StaticResource InvertBoolConverter}, ConverterParameter=invertNull}"
                                    Height="32" Padding="12,0"/>
                        </Grid>

                        <!-- 連線表單 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Profile Name -->
                            <hc:TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_Profile_Name}"
                                        hc:InfoElement.Placeholder="例如：開發本機 PostgreSQL"/>

                            <!-- Host + Port -->
                            <hc:TextBox Grid.Row="2" Grid.Column="0"
                                        Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_Host}"
                                        hc:InfoElement.Placeholder="localhost"/>
                            <hc:TextBox Grid.Row="2" Grid.Column="2"
                                        Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_Port}"
                                        hc:InfoElement.Placeholder="5432"/>

                            <!-- Database -->
                            <hc:TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                        Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_Database}"
                                        hc:InfoElement.Placeholder="postgres"/>

                            <!-- Username -->
                            <hc:TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Settings_Username}"
                                        hc:InfoElement.Placeholder="postgres"/>

                            <!-- 分隔線 -->
                            <Separator Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4"/>

                            <!-- 密碼 + 測試連線 + 儲存設定檔 -->
                            <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Settings_Password}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="PwdBox"
                                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="{l:Loc Settings_TestConnection}"
                                        Style="{StaticResource ButtonDefault}"
                                        VerticalAlignment="Bottom"
                                        Padding="14,0" Height="32"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertBoolConverter}}"/>

                                <Button Grid.Column="4"
                                        Content="{l:Loc Settings_Profile_Save}"
                                        Style="{StaticResource ButtonPrimary}"
                                        VerticalAlignment="Bottom"
                                        Padding="16,0" Height="32"
                                        Command="{Binding SaveProfileCommand}"/>
                            </Grid>

                            <!-- 連線狀態輸出 -->
                            <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="{Binding ServerVersionDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ConnectionStatusMessage}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
