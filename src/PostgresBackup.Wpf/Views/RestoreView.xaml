<UserControl x:Class="PostgresBackup.Wpf.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:PostgresBackup.Wpf.Converters"
             xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28" MaxWidth="920">

            <!-- 頁面標題 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="4" Height="24" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                <TextBlock Text="{l:Loc Restore_Title}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── 卡片 1: 還原設定與參數 ── -->
            <hc:Card Margin="0,0,0,24" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="14"/>
                            <TextBlock Text="{l:Loc Restore_Card_Config}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,20">

                        <!-- 來源檔案選取 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <hc:TextBox Grid.Column="0"
                                        Text="{Binding SourceFilePath, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Restore_SourceFile}"
                                        hc:InfoElement.Placeholder="請選取 .dump 或 .sql 備份檔案"
                                        Height="32"/>
                            <Button Grid.Column="2"
                                    Content="{l:Loc Settings_Browse}"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding BrowseSourceFileCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="14,0"/>
                        </Grid>

                        <!-- 目標連線與目標資料庫 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <hc:ComboBox Grid.Column="0"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile}"
                                         DisplayMemberPath="DisplayName"
                                         hc:InfoElement.Title="{l:Loc Restore_TargetProfile}"
                                         Height="32"/>
                            <hc:TextBox Grid.Column="2"
                                        Text="{Binding TargetDatabase, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Title="{l:Loc Restore_TargetDb}"
                                        Height="32"/>
                        </Grid>

                        <!-- 還原模式選取 -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{l:Loc Restore_Mode}" FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <ComboBox SelectedIndex="0" Height="32"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Mode, Mode=TwoWay}">
                                <ComboBoxItem Content="{l:Loc Restore_Mode_Normal}" Tag="{x:Static l:RestoreModeHelper.Normal}"/>
                                <ComboBoxItem Content="{l:Loc Restore_Mode_Clean}" Tag="{x:Static l:RestoreModeHelper.CleanAndRecreate}"/>
                                <ComboBoxItem Content="{l:Loc Restore_Mode_DataOnly}" Tag="{x:Static l:RestoreModeHelper.DataOnly}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 前置安全快照防護設定 -->
                        <Border Background="#082E7D32" BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ " FontSize="13"/>
                                        <TextBlock Text="{l:Loc Restore_Snapshot_Label}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:Loc Restore_Snapshot_Desc}"
                                               FontSize="11" Margin="22,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding CreatePreRestoreSnapshot}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ⚠️ 高危險操作二次確認警示框 -->
                        <Border Background="#FFF8E1" BorderBrush="#FFA000" BorderThickness="1"
                                CornerRadius="6" Padding="16,14" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{l:Loc Restore_Warning_Title}"
                                               FontWeight="Bold" FontSize="13" Foreground="#C62828"/>
                                </StackPanel>
                                <TextBlock Text="{l:Loc Restore_Warning_Desc}"
                                           FontSize="12" Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Margin="0,0,0,10">
                                    <Run Text="{l:Loc Restore_Confirm_Prompt}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding TargetDatabase}" FontWeight="Bold" Foreground="#C62828"/>
                                </TextBlock>
                                <CheckBox IsChecked="{Binding IsConfirmed}"
                                          Content="{l:Loc Restore_Confirm_Checkbox}"
                                          FontWeight="SemiBold"
                                          Foreground="#B71C1C"/>
                            </StackPanel>
                        </Border>

                        <!-- 執行還原按鈕 -->
                        <Button Content="{l:Loc Restore_Start}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="36" FontSize="14" FontWeight="SemiBold"
                                Command="{Binding StartRestoreCommand}"
                                IsEnabled="{Binding IsConfirmed}"/>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

            <!-- ── 卡片 2: 即時終端輸出與日誌 ── -->
            <hc:Card Margin="0,0,0,16" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💻 " FontSize="14"/>
                                <TextBlock Text="{l:Loc Backup_Terminal}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{l:Loc Backup_ClearLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding ClearLogCommand}"
                                        Padding="10,2" Margin="0,0,8,0" Height="26" FontSize="11"/>
                                <Button Content="{l:Loc Backup_CopyLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding CopyLogCommand}"
                                        Padding="10,2" Height="26" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#181818" CornerRadius="0,0,4,4" Padding="12" MinHeight="180">
                        <TextBox Text="{Binding TerminalOutput, Mode=OneWay}"
                                 Background="Transparent"
                                 Foreground="#E0E0E0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="220"/>
                    </Border>
                </StackPanel>
            </hc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
