<UserControl x:Class="PostgresBackup.Wpf.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:PostgresBackup.Wpf.Converters"
             xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
             FontSize="13"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid Margin="24,14,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                </Grid.RowDefinitions>

            <!-- 頁面標題 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="4" Height="22" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="{l:Loc Restore_Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 作業狀態：快照與還原可能耗時，狀態固定顯示在頁面上方。 -->
            <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{Binding StatusKind, Converter={StaticResource OperationStatusToBrushConverter}}"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusBadgeText}" Foreground="White"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                                         Foreground="#1976D2"
                                         Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10"
                                Background="#FFF7F7" BorderBrush="#F0C7C7" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Loc Common_ErrorDetails}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#8B1E1E" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{l:Loc Common_CopyError}"
                                            Style="{StaticResource ButtonDefault}" Command="{Binding CopyErrorDetailsCommand}"
                                            Padding="10,2" Height="26" FontSize="11"/>
                                </Grid>
                                <TextBox Grid.Row="1" Margin="0,8,0,0" Height="150" Padding="8"
                                         Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                         Background="White" BorderBrush="#E0E0E0" VerticalContentAlignment="Top"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 卡片 1: 還原設定與參數 ── -->
            <hc:Card Grid.Row="2" Margin="0,0,0,14" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     IsEnabled="{Binding IsRestoring, Converter={StaticResource InvertBoolConverter}}">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="16,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconRestoreGeometry}" Fill="White"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc Restore_Card_Config}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="18,12,18,14">

                        <!-- 來源檔案選取 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc Restore_SourceFile}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SourceFilePath, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center"
                                         hc:InfoElement.Placeholder="{l:Loc Restore_SourceFile_Placeholder}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="{l:Loc Settings_Browse}"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding BrowseSourceFileCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="16,0"/>
                        </Grid>

                        <!-- 目標連線與目標資料庫 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc Restore_TargetProfile}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="DisplayName"
                                          Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Restore_TargetDb}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding TargetDatabase, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 還原模式選取 -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Restore_Mode}" FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ComboBox SelectedIndex="0" Height="32" VerticalContentAlignment="Center"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Mode, Mode=TwoWay}">
                                <ComboBoxItem Content="{l:Loc Restore_Mode_Normal}" Tag="{x:Static l:RestoreModeHelper.Normal}"/>
                                <ComboBoxItem Content="{l:Loc Restore_Mode_Clean}" Tag="{x:Static l:RestoreModeHelper.CleanAndRecreate}"/>
                                <ComboBoxItem Content="{l:Loc Restore_Mode_DataOnly}" Tag="{x:Static l:RestoreModeHelper.DataOnly}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 前置安全快照防護設定 -->
                        <Border Background="#082E7D32" BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconShieldCheckGeometry}" Fill="{DynamicResource PrimaryBrush}"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:Loc Restore_Snapshot_Label}"
                                                   FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:Loc Restore_Snapshot_Desc}"
                                               FontSize="11" Margin="22,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding CreatePreRestoreSnapshot}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ⚠️ 高危險操作二次確認警示框 -->
                        <Border Background="#FFF8E1" BorderBrush="#FFA000" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconAlertWarningGeometry}" Fill="#C62828"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{l:Loc Restore_Warning_Title}"
                                               FontWeight="Bold" FontSize="13" Foreground="#C62828" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{l:Loc Restore_Warning_Desc}"
                                           FontSize="11" Foreground="#D32F2F" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Margin="0,0,0,8" FontSize="11">
                                    <Run Text="{l:Loc Restore_Confirm_Prompt}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding TargetDatabase}" FontWeight="Bold" Foreground="#C62828"/>
                                </TextBlock>
                                <CheckBox IsChecked="{Binding IsConfirmed}"
                                          Content="{l:Loc Restore_Confirm_Checkbox}"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Foreground="#B71C1C"/>
                            </StackPanel>
                        </Border>

                        <!-- 執行還原按鈕 -->
                        <Button Content="{l:Loc Restore_Start}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="36" FontSize="14" FontWeight="SemiBold"
                                Command="{Binding StartRestoreCommand}"
                                IsEnabled="{Binding CanStartRestore}"/>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

            <!-- ── 卡片 2: 即時終端輸出與日誌 ── -->
            <hc:Card Grid.Row="3" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                     MaxHeight="420" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconTerminalGeometry}" Fill="White"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Backup_Terminal}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{l:Loc Backup_ClearLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding ClearLogCommand}"
                                        Padding="10,2" Margin="0,0,8,0" Height="26" FontSize="11"/>
                                <Button Content="{l:Loc Backup_CopyLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding CopyLogCommand}"
                                        Padding="10,2" Height="26" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#181818" CornerRadius="0,0,4,4" Padding="12" MinHeight="180">
                        <TextBox x:Name="TerminalBox"
                                 Style="{StaticResource TerminalTextBoxStyle}"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 TextChanged="TerminalBox_TextChanged"/>
                    </Border>
                </Grid>
            </hc:Card>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
