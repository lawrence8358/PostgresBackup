<UserControl x:Class="PostgresBackup.Wpf.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:PostgresBackup.Wpf.Converters"
             xmlns:l="clr-namespace:PostgresBackup.Wpf.Extensions"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,14,24,16" MaxWidth="920">

            <!-- 頁面標題 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="4" Height="22" Background="{DynamicResource PrimaryBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="{l:Loc Backup_Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── 卡片 1: 備份參數設定 ── -->
            <hc:Card Margin="0,0,0,14" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="16,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBoxGeometry}" Fill="White"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc Backup_Card_Config}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="18,12,18,14">

                        <!-- 連線設定檔選取 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc Backup_SelectProfile}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="DisplayName"
                                          Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="{l:Loc Backup_RefreshProfiles}"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding RefreshProfilesCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="14,0"/>
                        </Grid>

                        <!-- 格式與模式選取 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 格式選取 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc Backup_Format}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="0" Height="32" VerticalContentAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Format, Mode=TwoWay}">
                                    <ComboBoxItem Content="{l:Loc Backup_Format_Custom}" Tag="{x:Static l:BackupFormatHelper.Custom}"/>
                                    <ComboBoxItem Content="{l:Loc Backup_Format_Plain}" Tag="{x:Static l:BackupFormatHelper.Plain}"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 模式選取 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Backup_Mode}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="0" Height="32" VerticalContentAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Mode, Mode=TwoWay}">
                                    <ComboBoxItem Content="{l:Loc Backup_Mode_All}" Tag="{x:Static l:BackupModeHelper.SchemaAndData}"/>
                                    <ComboBoxItem Content="{l:Loc Backup_Mode_SchemaOnly}" Tag="{x:Static l:BackupModeHelper.SchemaOnly}"/>
                                    <ComboBoxItem Content="{l:Loc Backup_Mode_DataOnly}" Tag="{x:Static l:BackupModeHelper.DataOnly}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 範圍選取與物件輸入 -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{l:Loc Backup_Scope}" FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ComboBox SelectedIndex="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding Scope, Mode=TwoWay}">
                                <ComboBoxItem Content="{l:Loc Backup_Scope_Full}" Tag="{x:Static l:BackupScopeHelper.FullDatabase}"/>
                                <ComboBoxItem Content="{l:Loc Backup_Scope_Schema}" Tag="{x:Static l:BackupScopeHelper.SpecificSchemas}"/>
                                <ComboBoxItem Content="{l:Loc Backup_Scope_Table}" Tag="{x:Static l:BackupScopeHelper.SpecificTables}"/>
                            </ComboBox>

                            <!-- 綱要與資料表 (併排雙欄排列，節省高度) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{l:Loc Backup_Schemas_Title}" FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SchemasText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" VerticalContentAlignment="Center"
                                             hc:InfoElement.Placeholder="{l:Loc Backup_Schemas_Placeholder}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Loc Backup_Tables_Title}" FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding TablesText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32" VerticalContentAlignment="Center"
                                             hc:InfoElement.Placeholder="{l:Loc Backup_Tables_Placeholder}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 輸出目錄與檔名預覽 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l:Loc Backup_OutputDir}" FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="{l:Loc Settings_Browse}"
                                    Style="{StaticResource ButtonDefault}"
                                    Command="{Binding BrowseOutputDirectoryCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="32" Padding="16,0"/>
                        </Grid>

                        <Border Background="#08000000" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Loc Backup_FileName}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding FileNamePreview}"
                                           FontFamily="Consolas" FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Grid>
                        </Border>

                        <!-- 執行備份按鈕 -->
                        <Button Content="{l:Loc Backup_Start}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="36" FontSize="14" FontWeight="SemiBold"
                                Command="{Binding StartBackupCommand}"
                                IsEnabled="{Binding IsBackingUp, Converter={StaticResource InvertBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

            <!-- ── 卡片 2: 即時終端輸出與日誌 ── -->
            <hc:Card Margin="0,0,0,16" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4,4,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconTerminalGeometry}" Fill="White"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Backup_Terminal}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{l:Loc Backup_ClearLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding ClearLogCommand}"
                                        Padding="10,2" Margin="0,0,8,0" Height="26" FontSize="11"/>
                                <Button Content="{l:Loc Backup_CopyLog}"
                                        Style="{StaticResource ButtonDefault}"
                                        Command="{Binding CopyLogCommand}"
                                        Padding="10,2" Height="26" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#181818" CornerRadius="0,0,4,4" Padding="12" MinHeight="180">
                        <TextBox x:Name="TerminalBox"
                                 Style="{StaticResource TerminalTextBoxStyle}"
                                 Height="220"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 TextChanged="TerminalBox_TextChanged"/>
                    </Border>
                </StackPanel>
            </hc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
